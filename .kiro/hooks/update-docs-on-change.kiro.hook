{
  "enabled": true,
  "name": "Update Docs on Source Change",
  "description": "When TypeScript source files, configuration files, or Dockerfiles are edited, ask the agent to update the README or relevant documentation to reflect the changes.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.ts",
      "*.tsx",
      "package.json",
      "tsconfig.json",
      "Dockerfile",
      "Dockerfile.*"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file was just edited. Review the change and determine if the project's documentation (README.md at the repo root, or any docs/ folder if one exists) needs to be updated to reflect it. If so, make the necessary documentation updates. Focus on things like: new or changed APIs, updated configuration, new packages/services, changed architecture, or modified setup instructions. If the change is purely internal (refactoring, bug fix with no user-facing impact), no documentation update is needed."
  }
}
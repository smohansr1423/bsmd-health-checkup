{
  "name": "@calorie-cortisol/root",
  "version": "0.1.0",
  "private": true,
  "description": "Calorie & Cortisol Tool — monorepo root (six microservices, gateway, clients, shared contracts)",
  "workspaces": [
    "shared",
    "gateway",
    "services/cortisol-data",
    "services/notification",
    "clients/pwa",
    "clients/shared"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:setup:py": "python -m venv .venv && .venv/Scripts/python -m pip install fastapi uvicorn pydantic",
    "build": "tsc --build",
    "test": "jest --passWithNoTests",
    "test:node": "jest --passWithNoTests",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\""
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@jest/types": "^29.6.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "fast-check": "^3.15.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
